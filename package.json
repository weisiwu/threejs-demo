{
  "name": "threejs-demo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "tsx --test tests/mechanisms.test.ts",
    "test:e2e": "playwright test",
    "check:catalog": "tsx scripts/check-catalog.ts",
    "format": "prettier --write src scripts tests *.ts *.html *.json docs README.md NOTICE.md .github/workflows/pages.yml",
    "docs": "tsx scripts/generate-research.ts",
    "models": "node scripts/export-models.mjs"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22.19.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.183.1",
    "prettier": "3.9.9",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite": "8.3.2"
  }
}
